        \u1014\u1031\u102C\u1000\u103A\u1011\u1015\u103A\u1019\u103B\u102C\u1038\u1021\u1010\u103D\u1000\u103A
        \u1015\u103C\u1014\u103A\u101C\u100A\u103A\u1021\u1000\u1032\u1016\u103C\u1010\u103A\u1015\u102B\u104B     
        \u1021\u1014\u102D\u102F\u1004\u103A\u101B\u1010\u101A\u103A\u104B \u1021\u1014\u102D\u102F\u1004\u103A\u101B\u1010\u1032\u1037
        \u101E\u1004\u103A\u1039\u1000\u1031\u1010\u1010\u103D\u1031 \u1019\u101B\u103E\u102D\u101B\u1004\u103A\u104A     

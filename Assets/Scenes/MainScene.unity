  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 1. "The Combo Multiplier" has \n   4 levels as  x1, x2, x3,x5 in normal
    game.\n2. All wins and pays are multiplied by the\n    "Combo Multiplier".\n3.
    The "Combo Multiplier" is start from x1 for\n    first elimination of wins and
    pays.\n 4. The "Combo Multiplier" is increased to \n    x2 after elimination
    of any wins and pays\n   from multiplier level as x1.\n5. The "Combo Multiplier"
    is increased to x3 \n   after elimination of any wins and pays \n   from multiplier
    level as x2. \n6. The "Combo Multiplier" is\n   increased to x5 after elimination
    of \n   any wins and pays from multiplier level as \n   x3.\n7. The "Combo Multiplier"
    resets to x1 by no \n   wins and pays of for starts the next spin.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 44eb99416ad464293b8298b8e6361e9f, type: 2}

    - target: {fileID: 8645518408272877438, guid: 6ca31c49fd6214f1e8bba2eaa30c4988, type: 3}
      propertyPath: 'Data.Array.data[646]'
      value: "1. Super Ace l\xE0 m\u1ED9t slot video c\xF3 5      cu\u1ED9n, 4 h\xE0ng

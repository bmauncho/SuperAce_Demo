    - target: {fileID: 8645518408272877438, guid: 6ca31c49fd6214f1e8bba2eaa30c4988, type: 3}
      propertyPath: 'Data.Array.data[1174]'
      value: "Despu\xE9s de que gane la ficha dorada, se volver\xE1 salvaje en el

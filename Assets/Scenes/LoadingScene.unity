        NatoSansThai \u1010\u102D\u102F\u1037\u1000\u102D\u102F \"FallBack Font Assets\"
        \u1010\u103D\u1004\u103A \"TMP \u1006\u1000\u103A\u1010\u1004\u103A\u1019\u103B\u102C\u1038\"
        \u1010\u103D\u1004\u103A \u101B\u103E\u102C\u1016\u103D\u1031\u1015\u102B\u104B\r"
      objectReference: {fileID: 0}

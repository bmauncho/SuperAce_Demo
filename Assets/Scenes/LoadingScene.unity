    \u514D\u8CBB\u7B49\u7D1A\u70BA x2\u3001x4\u3001x6\u3001x10      \u904A\u6232\u3002
    3.\u514D\u8CBB\u904A\u6232\u898F\u5247\u540C     \u6B63\u5E38\u904A\u6232\uFF0C\u552F\u4E00\u5340\u5225    
    \u5728\u300C\u7D44\u5408\u4E58\u6578\u300D\u5C64\u7D1A\u3002 4.\u767B\u9678\u300A\u514D\u8CBB3\u300B    
    \u904A\u6232\u5C07\u89F8\u767C\u52A05\u514D\u8CBB     spin \u53EF\u4EE5\u5806\u758A\u3002"
  - "1.\u300C \u300D\u30923\u3064\u4EE5\u4E0A\u7740\u5730\u3055\u305B\u308B\u3068     
    10\u56DE\u7121\u6599\u3067\u7121\u6599\u30B2\u30FC\u30E0\u3092\u30C8\u30EA\u30AC\u30FC\u3059\u308B     
    \u56DE\u8EE2\u3057\u307E\u3059\u3002 2.\u300C\u30B3\u30F3\u30DC\u30DE\u30EB\u30C1\u30D7\u30E9\u30A4\u30E4\u30FC\u300D\u306F4\u3067\u3059\u3002      

  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1.\"The Combo Multiplier\" has 4 levels as  x1,   \n     x2, x3,x5 in
    normal game.\r\n2.All wins and pays are multiplied by the \n    \"Combo Multiplier\"\r\n3.The
    \"Combo Multiplier\" is start from x1 for \n     first elimination of wins and
    pays\r\n4.The \"Combo Multiplier\" is increased to x2 \n     after elimination
    of any wins and pays    \n     from multiplier level as x1.\r\n5.The \"Combo
    Multiplier\" is increased to x3 \n    after elimination of any wins and pays
    from \n    multiplier level as x2.\r\n6.The \"Combo Multiplier\" is increased
    to x5 \n    after elimination of any wins and pays from \n    multiplier level
    as x3.\r\n7.The \"Combo Multiplier\" resets to x1 by no \n    wins and pays of
    for starts the next spin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

        \u1021\u102C\u1038\u101C\u102F\u1036\u1038\u1021\u1014\u102D\u102F\u1004\u103A\u101B     
        \u101E\u1004\u103A\u1039\u1000\u1031\u1010(\u1019\u103B\u102C\u1038) \u1011\u1015\u103A\u1019\u1036
        \"\u101C\u103E\u1014\u103A\" \u1015\u102B\u1019\u100A\u103A\u104B \u1015\u103C\u102E\u1038\u1014\u1031\u102C\u1000\u103A    

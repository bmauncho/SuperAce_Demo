    - target: {fileID: 8645518408272877438, guid: 6ca31c49fd6214f1e8bba2eaa30c4988, type: 3}
      propertyPath: 'Data.Array.data[649]'
      value: "1. Super Ace \u101E\u100A\u103A 5 \u1015\u102B\u101B\u103E\u102D\u101E\u1031\u102C
        \u1017\u102E\u1012\u102E\u101A\u102D\u102F\u1021\u1011\u102D\u102F\u1004\u103A\u1010\u1005\u103A\u1001\u102F\u1016\u103C\u1005\u103A\u101E\u100A\u103A\u104B     

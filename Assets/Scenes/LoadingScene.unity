      objectReference: {fileID: 0}
    - target: {fileID: 8645518408272877438, guid: 6ca31c49fd6214f1e8bba2eaa30c4988, type: 3}
      propertyPath: 'Data.Array.data[1175]'
      value: Baada ya mshikaji dhahabu Kushinda, itageuka kuwa pori mahali pale pale

  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1.Lucky Poker is a video slot with 5 reels, \n   4 rows and 1024 ways.\r\n2.All
    wins pay with left most reel to right \n    on adjacent reels.\r\n3.During the
    game, all winning symbol(s)     \n    will \"flip\" again. After the \"flip\"
    will  \n    appear  new symbol(s) replaced the   \n    previous winning symbol(s)
    and re- \n    evalaute for more wins. If \n    there is no winning symbols after
    the \n    re-evaluated, the current game \n    winning amount will be awarded
    to   \n    player.\r\n4.Winnings = Pay x Lines x Bet.\r\n"
  m_isRightToLeft: 0

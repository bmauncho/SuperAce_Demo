        \u101B\u1015\u103A\u1010\u1014\u1037\u103A\u101E\u103D\u102C\u1038\u1019\u100A\u103A    
        \u1006\u102F\u1000\u103C\u1031\u1038\u1004\u103D\u1031 \u1015\u103C\u1031\u101C\u100A\u103A\u1019\u103E\u102F\u101B\u101C\u102D\u1019\u1037\u103A\u1019\u100A\u103A\u104B     
        \u101B\u103E\u1031\u1037\u1006\u1000\u103A\u1015\u102B\u104B 6. \u1001\u103B\u103D\u1010\u103A\u101A\u103D\u1004\u103A\u1038\u1001\u103B\u1000\u103A\u101E\u100A\u103A
        \u1015\u1031\u1038\u1001\u103B\u1031\u1019\u103E\u102F\u1019\u103B\u102C\u1038\u1021\u102C\u1038\u101C\u102F\u1036\u1038\u1000\u102D\u102F
        \u1015\u103B\u1000\u103A\u1015\u103C\u101A\u103A\u1005\u1031\u1015\u102B\u101E\u100A\u103A\u104B     
        \u1015\u103C\u1007\u102C\u1010\u103A\u1019\u103B\u102C\u1038\u104B \u1001\u103B\u102D\u102F\u1037\u101A\u103D\u1004\u103A\u1038\u1001\u103B\u1000\u103A\u1010\u1005\u103A\u1005\u102F\u1036\u1010\u1005\u103A\u101B\u102C
        \u1016\u103C\u1005\u103A\u1015\u1031\u102B\u103A\u1015\u102B\u1000\u104A    
        feature \u1002\u102D\u1019\u103A\u1038\u1000\u102C\u101C\u1021\u1010\u103D\u1004\u103A\u1038,
        the      \u1005\u1014\u1005\u103A\u1000 \u1021\u101C\u102D\u102F\u1021\u101C\u103B\u1031\u102C\u1000\u103A
        \u1015\u1031\u102B\u103A\u101C\u102C\u1015\u102B\u101C\u102D\u1019\u1037\u103A\u1019\u101A\u103A\u104B     
        \u1002\u102D\u1019\u103A\u1038\u1000\u102D\u102F\u1015\u103C\u102E\u1038\u1021\u1031\u102C\u1004\u103A\u101E\u1031\u1001\u103B\u102C\u1021\u1031\u102C\u1004\u103A\u101C\u102F\u1015\u103A\u1015\u102B\u104B     
        \u1000\u1005\u102C\u1038\u101E\u1019\u102C\u1038\u1000 \u101E\u1030\u1010\u102D\u102F\u1037\u101C\u1000\u103A\u1001\u1036\u1010\u101A\u103A\u104B     
        \u1021\u1031\u102C\u1004\u103A\u1019\u103C\u1004\u103A\u1019\u103E\u102F\u1019\u103B\u102C\u1038\u104B
        \u1018\u101A\u103A\u1019\u103E\u102C \u101C\u102F\u1015\u103A\u1010\u102C\u101C\u102C\u1038\u104B     
        \u1021\u1031\u102C\u103A\u1015\u101B\u1031\u1010\u102C\u1015\u103C\u102E\u1038\u1014\u1031\u102C\u1000\u103A\u1016\u103C\u1005\u103A\u1015\u1031\u102B\u103A\u101E\u100A\u103A\u104B     
        \u104F\u1021\u1000\u103C\u1031\u102C\u1004\u103A\u1038\u1000\u103C\u102C\u1038\u1005\u102C\u1000\u102D\u102F\u101C\u1000\u103A\u1001\u1036\u101B\u101B\u103E\u102D     
        \u1016\u1031\u102C\u1000\u103A\u101E\u100A\u103A\u104F\u101C\u1031\u102C\u1004\u103A\u1038\u1000\u1005\u102C\u1038\u1014\u103E\u1004\u1037\u103A\u1018\u101A\u103A\u1019\u103E\u102C\u101C\u1032\u104B     
        \u1016\u1031\u102C\u1000\u103A\u101E\u100A\u103A \u1019\u101B\u103E\u102D\u1010\u1031\u102C\u1037\u1015\u102B\u104B      
        \u101B\u101C\u1012\u103A\u1021\u1015\u1031\u102B\u103A\u101C\u103D\u103E\u1019\u103A\u1038\u1019\u102D\u102F\u1038\u1019\u103E\u102F     
        \u1015\u103D\u1032 \u101E\u102D\u102F\u1037\u1019\u101F\u102F\u1010\u103A
        \u101C\u1031\u102C\u1004\u103A\u1038\u1000\u1005\u102C\u1038\u101B\u101C\u1012\u103A\u1019\u103B\u102C\u1038     
        gamble stand.A game      \u101D\u102D\u102F\u1004\u103A\u1038\u1000 \u1001\u103B\u1000\u103A\u1001\u103B\u1004\u103A\u1038
        \u1015\u103C\u102E\u1038\u101C\u102D\u102F\u1000\u103A\u1010\u102C      win
        cap \u101F\u1030\u104D\u101C\u100A\u103A\u1038\u1000\u1031\u102C\u1004\u103A\u1038\u104A     
        \u1021\u1014\u102D\u102F\u1004\u103A\u101B\u101B\u103E\u102D\u1019\u103E\u102F\u1021\u102C\u1038\u101C\u102F\u1036\u1038\u1000\u102D\u102F
        \u1015\u1031\u1038\u1001\u103B\u1031\u1015\u102B\u1019\u100A\u103A\u104B     
        \u1021\u1019\u103B\u102C\u1038\u1006\u102F\u1036\u1038\u1015\u1031\u1038\u1001\u103B\u1031\u1019\u103E\u102F
        : 10,000,000      \u1021\u1019\u103B\u102C\u1038\u1006\u102F\u1036\u1038
        Win Odds : 10,000x      \u1021\u1014\u100A\u103A\u1038\u1006\u102F\u1036\u1038\u101C\u1031\u102C\u1004\u103A\u1038\u1000\u103C\u1031\u1038
        : 0.5     \u1021\u1019\u103B\u102C\u1038\u1006\u102F\u1036\u1038\u101C\u1031\u102C\u1004\u103A\u1038\u1000\u103C\u1031\u1038
        : 1,000\r"
      objectReference: {fileID: 0}
